#!/usr/bin/env bash
# ./demo            run the next lesson
# ./demo 7          run lesson 7
# ./demo list       show all lessons and your progress
# ./demo all        run everything
# ./demo psql       open a SQL prompt
# ./demo up|down    start or remove the database
set -euo pipefail
root=$(cd "$(dirname "$0")" && pwd); cd "$root"
progress=$root/.progress; touch "$progress"

in_db() {
  if [[ -n ${PGDEMO_LOCAL:-} ]]; then "$@"
  else docker compose exec -T -u postgres db "$@"; fi
}
lesson_path() { if [[ -n ${PGDEMO_LOCAL:-} ]]; then echo "$root/$1"; else echo "/demo/$1"; fi; }
up() { [[ -n ${PGDEMO_LOCAL:-} ]] || docker compose up -d --build --wait; }
lessons() { ls lessons/* | sort; }
title() { sed -n '1s/^\(-- \|# \)//p' "$1"; }
num() { basename "$1" | cut -d- -f1; }

run() {
  local f=$1
  printf '\n=== %s ===\n' "$(title "$f")"
  in_db bash "$(lesson_path lib/lesson.sh)" "$(lesson_path "$f")"
  grep -qx "$(num "$f")" "$progress" || num "$f" >> "$progress"
}

case ${1:-next} in
  up) up ;;
  down) docker compose down -v ;;
  psql) up; if [[ -n ${PGDEMO_LOCAL:-} ]]; then psql; else docker compose exec -u postgres db psql; fi ;;
  list) for f in $(lessons); do
          if grep -qx "$(num "$f")" "$progress"; then m='x'; else m=' '; fi
          printf '[%s] %s\n' "$m" "$(title "$f")"
        done ;;
  all) up; for f in $(lessons); do run "$f"; done ;;
  next) up
        for f in $(lessons); do
          grep -qx "$(num "$f")" "$progress" || { run "$f"; echo; echo "Next: ./demo"; exit 0; }
        done
        echo "All lessons done. Reset with: rm .progress" ;;
  *) n=$(printf '%02d' "$((10#$1))"); f=$(ls lessons/$n-* 2>/dev/null | head -1)
     [[ -n $f ]] || { echo "No lesson $1. Try: ./demo list"; exit 1; }
     up; run "$f" ;;
esac
